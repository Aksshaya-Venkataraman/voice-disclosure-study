# Copy-free setup: run `python scripts/generate_env.py --contact you@example.org`
# to create .env with random secrets. This file only documents the variables -
# it holds no values.

# Public hostname served by Caddy (use "localhost" for a local HTTPS test).
DOMAIN=localhost
# Researcher contact shown to participants on the consent page.
CONTACT_EMAIL=

# PostgreSQL: superuser (container only) and the app's least-privilege role.
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_USER=voice_study
APP_DB_PASSWORD=
APP_DB_NAME=voice_study

# Bearer token for the researcher API; >= 32 random characters.
RESEARCHER_TOKEN=

# Optional
# STUDY_TITLE=Interview study: how interviewer voices affect answers
# SHOW_PROMPT_TEXT=false
# Voice answers (Google Speech-to-Text):
# COMPOSE_FILE=docker-compose.yml:docker-compose.speech.yml
# ASR_LANGUAGE=en-GB
# GOOGLE_CREDENTIALS_FILE=./secrets/google-credentials.json

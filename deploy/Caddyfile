# Public entry point. Caddy obtains and renews TLS certificates automatically
# (Let's Encrypt for a real domain, a local CA for DOMAIN=localhost).
# Security headers (CSP, frame/permissions policies) are set by the gateway.
{$DOMAIN} {
	encode zstd gzip

	# Voice answers are uploaded as audio (gateway limit: 10 MB).
	request_body {
		max_size 11MB
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
		-Via
	}

	reverse_proxy gateway:8000 {
		health_uri /api/health
		health_interval 15s
	}

	log {
		output stdout
		format json
	}
}
